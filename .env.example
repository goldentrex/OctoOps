# Asset generation only (scripts/auto-generate-gemini-*.mjs). Never commit real values.
GEMINI_API_KEY=

# OctoGuard API (M2). If unset, write routes accept localhost requests only.
OCTOGUARD_API_TOKEN=
# Store backend: "file" (default, .data/governance.json) or "memory".
OCTOGUARD_STORE=
# Seed preset id (default: b2b-consultancy).
OCTOGUARD_PRESET=